#!/bin/sh
# Blocks commits containing API-key patterns or a .env file. Enable once per clone with:
#   git config core.hooksPath .githooks       (python tasks.py setup does this)
# Checks the staged content of every tracked file, not just the working tree.

status=0

env_files=$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '(^|/)\.env(\..*)?$' | grep -vE '(^|/)\.env\.example$')
if [ -n "$env_files" ]; then
    echo "pre-commit: refusing to commit an env file:" >&2
    echo "$env_files" >&2
    status=1
fi

# The length keeps out identifiers such as hf_home and jina_api_key.
pattern='gsk_[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{30,}|jina_[A-Za-z0-9]{20,}|hf_[A-Za-z0-9]{20,}'
key_files=$(git grep --cached -I -l -E "$pattern")
if [ -n "$key_files" ]; then
    echo "pre-commit: possible API key in (values not shown):" >&2
    echo "$key_files" >&2
    status=1
fi

if [ "$status" -ne 0 ]; then
    echo "pre-commit: commit blocked. Remove the secret, and rotate it if it was ever pushed." >&2
fi
exit "$status"
