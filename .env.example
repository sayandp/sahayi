GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PRIMARY=groq
LLM_MODEL_GROQ=openai/gpt-oss-120b
LLM_MODEL_GEMINI=gemini-3.6-flash
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
QDRANT_PATH=./data/index/qdrant
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
# Full path to tesseract.exe; leave empty to use tesseract from PATH. Do not quote
# (backslashes inside double quotes are treated as escapes).
TESSERACT_CMD=
# Caches on the repo drive (also the defaults in backend/app/config.py). Do not quote.
HF_HOME=D:\rag\data\cache\hf
PLAYWRIGHT_BROWSERS_PATH=D:\rag\data\cache\playwright
# Phase 3
API_PORT=8077
ANSWER_MODEL=qwen/qwen3.8-27b
ANSWER_MODEL_GEMINI=gemini-3.6-flash
# evals/configs.yaml entry the API retrieves with: default (local Jina int8 rerank) or
# deploy (hosted Jina rerank, falls back to local int8 on error / >1.5 s)
RETRIEVAL_CONFIG=default
JINA_API_KEY=
COHERE_API_KEY=
RATE_LIMIT_PER_MIN=10
# HMAC key for question hashes in logs (empty -> random per process)
LOG_SALT=
# Demo link (python tasks.py share)
DEMO_RATE_LIMIT_PER_MIN=5
DEMO_DAILY_CAP=100
